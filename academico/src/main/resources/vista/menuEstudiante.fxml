<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="controlador.MenuEstudianteController" prefWidth="700" prefHeight="400">
    <children>
        <Label text="Panel del Estudiante" layoutX="240" layoutY="20" style="-fx-font-size:18px; -fx-font-weight:bold;"/>

        <Button text="Ver Calificaciones" layoutX="80" layoutY="100" onAction="#verCalificaciones"/>
        <Button text="Ver Asistencias" layoutX="80" layoutY="150" onAction="#verAsistencias"/>

        <TableView fx:id="tablaEstudiante" layoutX="300" layoutY="80" prefWidth="360" prefHeight="250"/>
    </children>
</AnchorPane>
