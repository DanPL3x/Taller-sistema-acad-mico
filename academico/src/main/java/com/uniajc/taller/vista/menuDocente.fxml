<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="controlador.MenuDocenteController" prefWidth="700" prefHeight="400">
    <children>
        <Label text="Panel del Docente" layoutX="250" layoutY="20" style="-fx-font-size:18px; -fx-font-weight:bold;"/>

        <Button text="Registrar Clase" layoutX="80" layoutY="80" onAction="#registrarClase"/>
        <Button text="Registrar Asistencia" layoutX="80" layoutY="130" onAction="#registrarAsistencia"/>
        <Button text="Registrar Calificación" layoutX="80" layoutY="180" onAction="#registrarCalificacion"/>

        <TableView fx:id="tablaDocente" layoutX="300" layoutY="80" prefWidth="360" prefHeight="250"/>
    </children>
</AnchorPane>
