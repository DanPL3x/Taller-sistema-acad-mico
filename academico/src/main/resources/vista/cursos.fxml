<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="controlador.CursosController"
            prefWidth="700" prefHeight="400">
    <children>
        <Label text="Gestión de Cursos" layoutX="250" layoutY="20"
               style="-fx-font-size:18px; -fx-font-weight:bold;"/>

        <Label text="Nombre del Curso:" layoutX="50" layoutY="80"/>
        <TextField fx:id="txtNombreCurso" layoutX="180" layoutY="75" prefWidth="200"/>

        <Label text="Descripción:" layoutX="50" layoutY="120"/>
        <TextField fx:id="txtDescripcion" layoutX="180" layoutY="115" prefWidth="200"/>

        <Button text="Agregar" layoutX="420" layoutY="75" onAction="#agregarCurso"/>
        <Button text="Eliminar" layoutX="420" layoutY="115" onAction="#eliminarCurso"/>
        <Button text="Actualizar" layoutX="420" layoutY="155" onAction="#actualizarCurso"/>

        <TableView fx:id="tablaCursos" layoutX="50" layoutY="200" prefWidth="600" prefHeight="180">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                <TableColumn fx:id="colNombre" text="Nombre Curso" prefWidth="200"/>
                <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="350"/>
            </columns>
        </TableView>
    </children>
</AnchorPane>
