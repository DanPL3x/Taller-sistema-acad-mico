<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="controller.DocenteController" prefWidth="800" prefHeight="600">
    <top>
        <HBox spacing="10" style="-fx-padding:10;">
            <Label text="Panel Docente" style="-fx-font-size:16px; -fx-font-weight:bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Cerrar sesión" onAction="#cerrarSesion"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="10" style="-fx-padding:10;">
            <HBox spacing="10">
                <Button text="Ver Mis Cursos" onAction="#verCursos"/>
                <Button text="Gestionar Calificaciones" onAction="#gestionarCalificaciones"/>
            </HBox>
            <TableView fx:id="tablaDatos" prefHeight="450"/>
        </VBox>
    </center>
</BorderPane>
