<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="controlador.MenuAdministradorController" prefWidth="700" prefHeight="400">
    <children>
        <Label text="Panel del Administrador" layoutX="250" layoutY="20" style="-fx-font-size:18px; -fx-font-weight:bold;"/>

        <Button text="Gestionar Docentes" layoutX="80" layoutY="80" prefWidth="200" onAction="#abrirDocentes"/>
        <Button text="Gestionar Estudiantes" layoutX="80" layoutY="140" prefWidth="200" onAction="#abrirEstudiantes"/>
        <Button text="Gestionar Cursos" layoutX="80" layoutY="200" prefWidth="200" onAction="#abrirCursos"/>

        <TableView fx:id="tablaDatos" layoutX="320" layoutY="80" prefWidth="350" prefHeight="250"/>
    </children>
</AnchorPane>
