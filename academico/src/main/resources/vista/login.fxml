<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="controller.LoginController" prefWidth="400" prefHeight="300">
    <children>
        <Label text="Sistema Control Académico" layoutX="100" layoutY="30" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        <Label text="Usuario:" layoutX="70" layoutY="100"/>
        <TextField fx:id="txtUsuario" layoutX="150" layoutY="95" prefWidth="180"/>
        <Label text="Rol:" layoutX="70" layoutY="150"/>
        <ComboBox fx:id="cbRol" layoutX="150" layoutY="145" prefWidth="180"/>
        <Button text="Ingresar" onAction="#ingresarSistema" layoutX="150" layoutY="200" prefWidth="100"/>
    </children>
</AnchorPane>
